#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	[ -x /usr/bin/openpassd ] || return 1
	[ ! -e /etc/openpass/service-disabled ] || return 0
	mkdir -p /etc/openpass /var/run/openpass
	procd_open_instance openpass
	procd_set_param command /usr/bin/openpassd \
		-listen 0.0.0.0:8787 \
		-state /etc/openpass/state.json \
		-sing-box /usr/bin/sing-box
	procd_set_param respawn 3600 5 5
	# Allow a config operation and sing-box's graceful TUN cleanup to finish.
	procd_set_param term_timeout 30
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# The daemon catches SIGTERM and stops its child sing-box process.
	:
}

service_stopped() {
	# rc.common calls this after deleting the procd instance, so respawn is
	# disabled. The cleanup command waits for the asynchronous stop to end.
	[ -e /etc/openpass/service-disabled ] || return 0
	/usr/bin/openpassd -cleanup
}
