# OpenPass firewall4 include. It declares the sets and hook chains; the daemon
# writes runtime elements/rules to /var/run/openpass/91-openpass-dynamic.nft.
# Keeping the declarations here lets firewall4 reload them safely.
set proxy_clients {
	type ipv4_addr
	flags interval
}
set direct_clients {
	type ipv4_addr
	flags interval
}
set blocked_clients {
	type ipv4_addr
	flags interval
}
chain openpass_prerouting {
	type filter hook prerouting priority mangle; policy accept;
}
chain openpass_output {
	type filter hook output priority filter; policy accept;
}
chain openpass_dns_nat {
	type nat hook prerouting priority dstnat; policy accept;
}
chain openpass_dns_output {
	type nat hook output priority dstnat; policy accept;
}

chain openpass_forward {
	type filter hook forward priority -10; policy accept;
}
