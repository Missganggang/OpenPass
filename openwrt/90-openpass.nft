# OpenPass firewall4 include. It declares the sets and hook chains; the daemon
# writes runtime elements/rules to /var/run/openpass/91-openpass-dynamic.nft.
# Keeping the declarations here lets firewall4 reload them safely.
set proxy_clients {
	type ipv4_addr
	flags interval
}
set direct_clients {
	type ipv4_addr
	flags interval
}
set blocked_clients {
	type ipv4_addr
	flags interval
}
chain openpass_prerouting {
	type filter hook prerouting priority mangle; policy accept;
}
chain openpass_output {
	type filter hook output priority filter; policy accept;
}
chain openpass_dns_nat {
	# Run before dnsmasq's optional dns_redirect chain (dstnat - 5),
	# otherwise dnsmasq rewrites the destination back to port 53 before
	# OpenPass can send the query to sing-box's DoH listener on 1053.
	type nat hook prerouting priority dstnat - 10; policy accept;
}
chain openpass_dns_output {
	type nat hook output priority dstnat; policy accept;
}

chain openpass_forward {
	type filter hook forward priority -10; policy accept;
}

# Invoked before fw4 zone forwarding, allowing only the exact PPP/device
# pairs generated by OpenPass. The include remains empty while disabled.
chain openpass_l2tp_forward {
}
chain openpass_l2tp_nat {
	type nat hook postrouting priority srcnat + 1; policy accept;
}
